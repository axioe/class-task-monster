# 복사해서 사용: cp .env.example .env  (.env 는 git 에 올라가지 않습니다)
# docker compose 와 로컬 백엔드(local 프로필)가 같은 값을 사용합니다.

# --- PostgreSQL ---
POSTGRES_DB=classmonster
POSTGRES_USER=classmonster
POSTGRES_PASSWORD=change-me-db-password
# 호스트에서 DB 에 접속할 포트 (DB 툴, local 프로필용)
POSTGRES_PORT=5432

# --- Backend ---
# 32자 이상 임의 문자열. 예: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
# 시연용 샘플 데이터 생성 (교사 teacher / 학생 jiwoo 등)
SEED_DATA=true

# --- Frontend ---
# 브라우저로 접속할 포트 (http://localhost:3000)
FRONTEND_PORT=3000
