# 복사해서 사용: cp .env.example .env  (.env 는 git 에 올라가지 않습니다)
# 실제 비밀번호·키는 .env 에만 적고, 채팅·이슈·커밋에 붙여 넣지 마세요.

# ============================================================
# 1) 원격 공용 DB (Supabase) - remote / prod 프로필
#    Supabase 대시보드 [Connect] → "Session pooler" 의 값을 사용
#      Host : aws-?-ap-northeast-2.pooler.supabase.com  (화면에 표시된 값 그대로)
#      Port : 5432
#      User : postgres.<프로젝트 ref>
# ============================================================
DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=change-me-supabase-db-password
DB_POOL_SIZE=3

# ============================================================
# 2) 로컬 PostgreSQL - local 프로필 (gradlew localDb 또는 docker compose 의 db)
# ============================================================
POSTGRES_DB=classmonster
POSTGRES_USER=classmonster
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_PORT=5432

# ============================================================
# 3) Backend 공통
# ============================================================
# 32자 이상 임의 문자열. 예: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
# 시연용 샘플 데이터 생성 (교사 teacher / 학생 jiwoo 등)
#   비워 두면: local 프로필은 생성, remote/prod 는 생성 안 함
#   공용 DB 에 시연 데이터가 필요하면 처음 한 번만 true 로 실행
# SEED_DATA=true

# ============================================================
# 4) Docker 실행 시 프론트엔드 접속 포트 (http://localhost:3000)
# ============================================================
FRONTEND_PORT=3000
