{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "backend\\gradlew.bat", "-p", "backend", "bootRun", "--console=plain"],
      "port": 8080
    },
    {
      "name": "localdb",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "backend\\gradlew.bat", "-p", "backend", "localDb", "--console=plain"],
      "port": 5432
    },
    {
      "name": "backend-local",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "backend\\gradlew.bat", "-p", "backend", "bootRun", "--console=plain", "--args=--spring.profiles.active=local"],
      "port": 8080
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
